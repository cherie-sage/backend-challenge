{
  "name": "Backend Challenge Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/backend-challenge",
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python manage.py migrate",
  "forwardPorts": [8000, 5432],
  "portsAttributes": {
    "8000": { "label": "Django dev server" },
    "5432": { "label": "Postgres" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "GitHub.copilot"]
    }
  },
  "remoteUser": "root"
}
